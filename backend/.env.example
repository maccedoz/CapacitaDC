# Copie para backend/.env e ajuste. Nunca versione o .env.

# Banco (o docker-compose.yml sobe este Postgres para desenvolvimento).
DATABASE_URL=postgresql://admin:password123@localhost:5432/capacita_dc_db

# Chave das sessões. Gere com: python3 -c 'import secrets; print(secrets.token_urlsafe(48))'
JWT_SECRET_KEY=troque-esta-chave
# JWT_ALGORITHM=HS256
# ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Vercel Blob privado, onde ficam documentos dos materiais e anexos das entregas.
# Sem ele, os uploads falham (os testes simulam o Blob).
BLOB_READ_WRITE_TOKEN=

# Origens extras liberadas no CORS, separadas por vírgula. Vazio desliga o CORS,
# que não é necessário: o navegador fala com a API pela mesma origem.
CORS_ORIGINS=

# Senha do admin criado por `python -m app.seed`. Sem ela, o seed gera uma senha
# aleatória e a mostra uma vez. O ./dev.sh usa admin123 se não houver valor.
SEED_ADMIN_PASSWORD=
